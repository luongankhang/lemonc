// 
class CalHeightOfChild{
	void main(){
		float x;
		float y;
		float b;
		float g;
		x = 186.0;
		y = 162.0;
		b = calBoy(x,y);
		g = calGirl(x,y);
		printf("%f,%f,%f\n",x,y,b);
		printf("%f,%f,%f\n",x,y,g);
	}
	// (++13)/2 + 7.5
	float calBoy(float f,float m){
		float rs;
		rs = (f+m+13.0)/2.0+7.5;
		return rs;
		// return 1;
	}
	// (+-13)/2 + 7.5
	float calGirl(float f,float m){
		return (f+m-13.0)/2.0+7.5;
	}
}