class MethodCallTest04{
	void main(){
        int a;
        bool c;
        cal(1.0);
        getIntNum();
        getBool(getIntNum() > 10 && getFloat() > 20.0);
        c = false;
        if( !(c) )
            a = 7;
        else
           a = 8;
        printf("a=%d\n",a);// a = 7

        if( c ||   getBool(getIntNum() > 10 || getFloat() > 20.0))
            a = 9;
        else
           a = 10;
        printf("a=%d\n",a);// a = 9


	}



    // false
	bool cal(float a){
	    printf("cal=%f\n",a);
	    return a > 10.0 || true && getIntNum() > 19;
	}

	int getIntNum(){
	    int a;
	    a = 19;
	    printf("getIntNum=%d\n",a);
	    return a;
	}

	bool getBool(bool b){
	    //printf("getBool=%d\n",b);
	    return b;
	}

	float getFloat(){
        float a;
        a = 19.0;
        printf("getFloat=%f\n",a);
        return a;
	}
}
