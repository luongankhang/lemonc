class Gauss{
	void main(){
		int start;
		int end;
		int result;
		start = 1;
		end = 100;
		result = sum(start,end);//sum1100
		printf("Sum from %d to %d is %d",start,end,result);
	}
	
	int sum(int start,int end){
		printf("Start number is: %d, end number is: %d\n",start,end);
		return (start + end ) * (end - start + 1) / 2;
	}
}